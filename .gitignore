# ============================================================
# 11. PROJECT-SPECIFIC EXCEPTIONS
# ============================================================

# Keep documentation and agent collaboration instructions
!.gitignore
!README.md
!AGENTS.md
!CLAUDE.md

# Keep shared agent configurations/rules by default
# .claude/ and .codex/ are intentionally NOT ignored entirely.

# Keep reproducible data directories
!data/
!data/README.md

# Keep package-lock.json, pnpm-lock.yaml, yarn.lock,
# uv.lock, poetry.lock, and other dependency lockfiles.
# Approved scientific provenance and T32 integration report
!/docs/
/docs/*
!/docs/contrato_datos.md
!/docs/datos.md
!/docs/REVISION_T27.md
!/docs/region/
/docs/region/*
!/docs/region/ucayali_inei_2023.geojson
!/docs/t29/
/docs/t29/*
!/docs/t29/RESULTADO_T29.md
!/docs/t29/AUTORIZACION_T29.md
!/docs/t35/
/docs/t35/*
!/docs/t35/PRECHECK_T35.md
!/docs/t38/
/docs/t38/*
!/docs/t38/REPRODUCCION_T38.md
!/docs/t32/
/docs/t32/*
!/docs/t32/INTEGRACION_T32.md
!/docs/t32/PROCEDENCIA_T32.json

# Local frontend reference; v2 and regression tests must not depend on it.
/frontend/src/legacy/

# Approved national integration contract and provenance (stage 1)
!/docs/peru/
/docs/peru/*
!/docs/peru/SOURCE_README.md
!/docs/peru/PROCEDENCIA_ETAPA1.json
!/docs/peru/INTEGRACION_ETAPA1.md

# Approved national map integration evidence (stage 2)
!/docs/peru/PROCEDENCIA_ETAPA2.json
!/docs/peru/INTEGRACION_ETAPA2.md
!/docs/peru/DESPLIEGUE_COMPRESION.md

# Official INEI boundaries and derived navigation provenance
!/docs/region/departamentos_inei_2023.geojson
!/docs/peru/NAVEGACION_DEPARTAMENTAL.md

# Monthly descriptive historical analysis
!/docs/ANALISIS_HISTORICO.md
!/docs/AUDITORIA_MI_REGION.md
